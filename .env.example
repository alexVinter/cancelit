# API-ключ Gemini владельца сервиса (от Google AI Studio: https://aistudio.google.com/app/apikey)
# При деплое на сервер (Vercel, Netlify, VPS) укажите эту переменную — и все пользователи сервиса
# смогут анализировать рекламу сразу, без ввода каких-либо ключей со своей стороны.
VITE_GEMINI_API_KEY=

# URL Cloudflare Worker прокси для обхода блокировок в РФ (по умолчанию уже настроен рабочий воркер):
# VITE_GEMINI_BASE_URL=https://gemini-proxy.aleksejvinter51.workers.dev
